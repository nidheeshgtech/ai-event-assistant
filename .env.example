# AI Event Assistant — environment variables
# Copy to .env.local. Everything is optional: with nothing set, the assistant runs on its
# structured engine (no AI keys, no backend) and the dashboard keeps edits in the browser.

# ---------- Browser (bundled into the client — never put secrets here) ----------

# Enables AI answers for questions the structured engine can't cover.
# Point at the serverless function deployed with this app.
VITE_AI_ENDPOINT=
# VITE_AI_ENDPOINT=/api/assistant

# Demo-request form delivery (FormSubmit AJAX endpoint). Defaults to the owner's inbox.
VITE_LEADS_ENDPOINT=

# Set to "required" in production until real admin authentication is connected;
# the client-side dashboard then shows a sign-in-required screen instead of the editor.
VITE_ADMIN_AUTH=

# ---------- Server only (Vercel project settings → Environment Variables) ----------

# Anthropic API key used by api/assistant.ts. Never prefix with VITE_.
ANTHROPIC_API_KEY=

# Model for AI answers (default: claude-opus-5-5).
AI_MODEL=

# Per-client limits for the AI endpoint (defaults: 8 per minute, 60 per hour).
AI_RATE_PER_MINUTE=
AI_RATE_PER_HOUR=

# Comma-separated origins allowed to call the AI endpoint, e.g. https://your-domain.com
AI_ALLOWED_ORIGINS=
